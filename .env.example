# Copy to .env and fill in. Every empty credential falls back to a mock/dummy mode.
# See README.md "Variabel .env" for how to obtain each value.

APP_ENV=dev
APP_BASE_URL=http://localhost:8000
# docker compose sets DATABASE_URL to its own db service; this value is for running outside docker.
DATABASE_URL=postgresql+asyncpg://hotelpilot:hotelpilot@localhost:5432/hotelpilot
TIMEZONE=Asia/Makassar

# --- Admin auth (Supabase-compatible HS256 JWT) ---
JWT_SECRET=
ADMIN_PASSWORD=
ENCRYPTION_KEY=

# --- LLM: Shiteru AI (OpenAI-compatible). Empty LLM_API_KEY -> mock LLM ---
LLM_BASE_URL=https://shiteru.id/v1
LLM_MODEL=kimi-k3.1-pro
LLM_API_KEY=
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=4
LLM_USD_PER_M_BILLED_TOKENS=0.09
LLM_DAILY_BUDGET_USD=2.0

# --- Threads (Meta). Empty token -> dummy channel ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- Blog webhook to an external frontend (optional) ---
FRONTEND_REVALIDATE_URL=
WEBHOOK_SECRET=

# --- Alerts (optional; empty -> log only) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ingestion: auto = live open data, fall back to bundled fixtures on failure ---
INGEST_MODE=auto
OVERTURE_RELEASE=
